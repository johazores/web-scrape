# Required
BASE_URL=https://example.com

# Crawl limits
MAX_PAGES=500
MAX_DEPTH=5
CONCURRENCY=2
REQUEST_TIMEOUT_MS=15000
REQUEST_DELAY_MS=500
RETRY_ATTEMPTS=2
MAX_REDIRECTS=10
MAX_SITEMAPS=50

# Discovery and responsible crawling
USER_AGENT=WebsiteMigrationTool/1.0
RESPECT_ROBOTS=true
DISCOVER_SITEMAPS=true
SITEMAP_URLS=
INCLUDE_URL_PATTERNS=
EXCLUDE_URL_PATTERNS=/wp-admin*,/login*,/cart*,/checkout*
ALLOWED_HOSTS=
DROP_TRACKING_PARAMS=true
REMOVE_QUERY_PARAMS=

# Output and recovery
OUTPUT_DIR=output
OUTPUT_FORMATS=json,markdown,csv
RESUME=true
RECRAWL_COMPLETED=false
DOWNLOAD_MEDIA=false
MAX_MEDIA_FILES=1000

# Content extraction
CONTENT_SELECTORS=main,article,#content,.content,.entry-content
EXCLUDE_SELECTORS=script,style,noscript,iframe,nav,footer,.cookie-banner,.modal

# Optional authentication
COOKIE=
AUTH_TYPE=
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_TOKEN=
EXTRA_HEADERS=

# Optional JavaScript rendering. Playwright must be installed separately.
JS_RENDERING=false
JS_RENDER_WAIT_MS=0
